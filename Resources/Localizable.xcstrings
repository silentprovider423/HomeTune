    "Das Konto „%@“ wird von diesem iPhone entfernt. Auf dem Server bleibt alles erhalten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The account “%@” will be removed from this iPhone. Everything stays on the server."
          }
        }
      }
    },
    "Das Passwort bleibt im Schlüsselbund dieses iPhones. Die App spricht nur mit deinem Server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The password stays in this iPhone’s keychain. The app only talks to your server."
          }
        }
      }
    },
