    "Dein Signatur-Profil gilt für die App-ID %@. Damit der Dateien-Dialog Musik übergeben kann, im Sideload-Tool die Bundle-ID auf %@ setzen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Signatur-Profil gilt für die App-ID %1$@. Damit der Dateien-Dialog Musik übergeben kann, im Sideload-Tool die Bundle-ID auf %2$@ setzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your signing profile is for the app ID %1$@. For the Files dialog to hand over music, set the bundle ID to %2$@ in your sideloading tool."
          }
        }
      }
    },
    "Deine Musik vom eigenen Navidrome-Server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your music from your own Navidrome server."
